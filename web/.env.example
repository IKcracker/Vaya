# Public site URL used for metadata/canonical URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres pooled connection string used by the running application.
# Example: postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Neon direct/unpooled connection string used by Drizzle migrations.
# The hostname should NOT contain "-pooler".
DATABASE_URL_UNPOOLED=

# Neon Auth (managed Better Auth) base URL for this branch.
# Provision Neon Auth on the same Neon branch used by the CRM.
NEON_AUTH_BASE_URL=

# Comma-separated emails that are allowed to access the Vaya Admin CRM.
# Users with a Neon Auth role of "admin" are also allowed.
ADMIN_EMAILS=admin@vaya.co.za

# Paystack secret key used only by the Next.js backend.
# Never expose this value to the Expo app.
PAYSTACK_SECRET_KEY=

# Public HTTPS callback page configured for Paystack checkout.
# Example: https://vaya.co.za/payment/callback
PAYSTACK_CALLBACK_URL=


# Origin registered in the Neon Auth branch used by this deployment.
# Leave empty to use NEXT_PUBLIC_SITE_URL / the Vercel production domain.
NEON_AUTH_ORIGIN=

# Comma-separated browser origins allowed to call the mobile/public API.
# Add http://localhost:8081 here to use Expo Web against a deployed backend.
MOBILE_WEB_ORIGINS=

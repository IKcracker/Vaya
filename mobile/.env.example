# Optional explicit Vaya backend URL.
#
# Local development:
# - Web / iOS simulator can use http://localhost:3000.
# - Android emulator can use http://10.0.2.2:3000.
# - Physical iOS/Android devices automatically derive the Expo/Metro LAN host
#   when this value is empty OR still points at localhost.
#
# Production builds should set this to the deployed HTTPS Vaya backend.
EXPO_PUBLIC_API_URL=

# Required for Android maps in development/release builds (Expo Go supplies its own).
# Enable Maps SDK for Android and restrict this key to co.za.vaya.app and your
# signing certificate. Set the same variable in the selected EAS environment.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
